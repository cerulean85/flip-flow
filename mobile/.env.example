# 이 파일은 변수 목록 참고용입니다.
# 실제 값은 환경별 파일에 작성하세요:
#   - 개발: .env.development  (참고: .env.development.example)
#   - 배포: .env.production   (참고: .env.production.example)
# 또는 모든 환경 공통 fallback 으로 .env 에 두어도 됩니다.

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# 1 이면 서버 없이 앱 안의 데모 데이터로 실행합니다 (로그인 생략, 변경 내용은 앱을 다시 켜면 초기화)
EXPO_PUBLIC_DEMO_MODE=
